{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (warnings as errors)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "COLLATZ_WERROR": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ci",
            "displayName": "CI (release, warnings as errors)",
            "inherits": "release",
            "cacheVariables": {
                "COLLATZ_WERROR": "ON"
            }
        },
        {
            "name": "asan",
            "displayName": "Address + UB sanitizers",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "ci", "configurePreset": "ci" },
        { "name": "asan", "configurePreset": "asan" }
    ],
    "testPresets": [
        {
            "name": "base-test",
            "hidden": true,
            "output": { "outputOnFailure": true }
        },
        { "name": "debug", "inherits": "base-test", "configurePreset": "debug" },
        { "name": "release", "inherits": "base-test", "configurePreset": "release" },
        { "name": "ci", "inherits": "base-test", "configurePreset": "ci" },
        { "name": "asan", "inherits": "base-test", "configurePreset": "asan" }
    ]
}
